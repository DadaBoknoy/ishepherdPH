      .portal-brand-login { width:104px; }
      .portal-brand-nav { width:56px; }
      #login-gate-page > div { padding:24px; }
    }
    .sync-field[contenteditable="true"]:empty::before { content: "Not set"; opacity: .55; font-weight: 400; }
    .sync-field[contenteditable="true"]:empty { display: inline-block; min-width: 4ch; }
  
/* Administrator student recruitment */
#admin-dashboard-page > div { min-height:0; }
#admin-view-recruitment-sec { min-height:0; }
.recruit-toolbar { display:flex; flex-wrap:wrap; gap:12px; align-items:end; }
.recruit-toolbar label { flex:1 1 200px; }
#admin-view-recruitment-sec { font-size:14px; line-height:1.6; }
#admin-view-recruitment-sec label { display:block; color:#c7d2fe; font-weight:600; }
#admin-view-recruitment-sec :is(input,select,textarea) { display:block; width:100%; background:#172554; border:1px solid #6366f1; color:#f8fafc; border-radius:10px; padding:10px 12px; font:inherit; margin-top:4px; }
