<body class="bg-gradient-to-br from-sky-950 via-indigo-950 to-purple-950 text-slate-100 font-sans min-h-screen pb-12">

  <!-- FRONT LOGIN GATE -->
  <div id="login-gate-page" class="fixed inset-0 bg-slate-950 z-[200] flex items-center justify-center p-4">
    <div class="bg-gradient-to-br from-indigo-950 via-purple-950 to-slate-900 border-2 border-amber-400/50 rounded-3xl p-8 max-w-xl w-full shadow-2xl space-y-6 text-center backdrop-blur-md">
      <div class="space-y-2">
        <span class="text-3xl font-bold text-amber-300">i-Shepherd Portal</span>
        <p class="text-slate-300 text-sm">Please sign in to access the portal dashboard.</p>
      </div>
      <button onclick="document.getElementById('login-gate-page').classList.add('hidden')" class="w-full py-3 bg-gradient-to-r from-amber-500 to-rose-500 text-white font-bold rounded-xl shadow-lg hover:brightness-110 transition">Enter Portal</button>
    </div>
  </div>

  <!-- Header Navigation -->
  <header class="bg-indigo-950/80 border-b border-indigo-800/50 sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4 w-full md:w-auto justify-between">
        <div class="flex items-center gap-3">
          <span class="font-bold text-lg text-amber-300 tracking-wide">i-Shepherd Teacher Portal</span>
        </div>
        <div class="md:hidden w-full">
          <select id="student-selector-mobile" class="bg-indigo-900 border border-indigo-600 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-amber-400 w-full"></select>
        </div>
      </div>
      
      <!-- Teacher Portal Search & Student Selector -->
      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <div class="w-full sm:w-64">
          <input type="text" id="teacher-student-search" placeholder="🔍 Search teacher's students..." class="bg-indigo-900/90 border border-indigo-600 rounded-lg px-3 py-1.5 text-sm text-white placeholder-indigo-300 focus:outline-none focus:ring-2 focus:ring-amber-400 w-full" />
        </div>
        <div id="student-selector-container" class="hidden md:block w-full sm:w-auto">
          <select id="student-selector" class="bg-indigo-900 border border-indigo-600 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-amber-400 min-w-[200px]"></select>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 mt-6">
    <!-- Admin Portal Student Recruitment & Search Section -->
    <section id="admin-view-recruitment-sec" class="bg-indigo-950/60 border border-indigo-800/60 rounded-2xl p-6 backdrop-blur-sm">
      <h2 class="text-xl font-bold text-amber-300 mb-4 flex items-center gap-2">
        <span>Admin Portal Student Management</span>
      </h2>
      <div class="recruit-toolbar mb-4">
        <label class="w-full">
          <span>Search Admin Students:</span>
          <input type="text" id="admin-student-search" placeholder="Type student name or ID..." class="w-full mt-1 bg-indigo-900 border border-indigo-600 rounded-lg px-3 py-2 text-sm text-white placeholder-indigo-300 focus:outline-none focus:ring-2 focus:ring-amber-400" />
        </label>
      </div>

      <div class="recruit-layout">
        <!-- Sorted Student List -->
        <div class="recruit-list" id="admin-recruit-list">
          <!-- Populated dynamically in alphabetical order -->
        </div>

        <div class="recruit-box">
          <h4>Student Details & Image Upload</h4>
          <p class="recruit-note mb-3">Drag & drop or upload a photo into the frame below to adjust and crop student pictures.</p>
          
          <div class="photo-frame drop-zone border-2 border-dashed border-indigo-400 bg-indigo-900/40 rounded-xl p-6 flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] transition hover:border-amber-400">
            <span class="text-3xl mb-2">📸</span>
            <p class="text-xs text-indigo-200 font-semibold">Drag & Drop Student Photo Here</p>
            <p class="text-[10px] text-indigo-400 mt-1">Supports JPG, PNG (Opens Cropper)</p>
            <input type="file" class="hidden-file-input hidden" accept="image/*" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Photo Crop Modal -->
  <div id="crop-modal" class="fixed inset-0 bg-slate-950/80 z-[300] hidden flex items-center justify-center p-4">
    <div class="bg-indigo-950 border-2 border-indigo-600 rounded-2xl p-6 max-w-xl w-full flex flex-col gap-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-indigo-800 pb-3">
        <h3 class="text-lg font-bold text-amber-300">Crop & Adjust Image</h3>
        <button id="cancel-crop-x" class="text-indigo-400 hover:text-white text-xl font-bold">&times;</button>
      </div>
      <div class="max-h-[50vh] overflow-hidden flex items-center justify-center bg-slate-900 rounded-lg p-2 border border-indigo-800">
        <img id="crop-image-target" src="" alt="Target Image for Cropping" class="max-w-full max-h-[45vh] block" />
      </div>
      <div class="flex justify-end gap-3 mt-2">
        <button id="cancel-crop-btn" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-sm font-semibold transition">Cancel</button>
        <button id="apply-crop-btn" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-rose-500 hover:brightness-110 text-white rounded-lg text-sm font-semibold transition">Apply & Crop</button>
      </div>
    </div>
  </div>

  <script>
    // Global Cropper & Target Variables
    let activeCropper = null;
    let activeTargetFrame = null;

    // Crop Modal Elements
    const cropModal = document.getElementById('crop-modal');
    const cropImageTarget = document.getElementById('crop-image-target');
    const applyCropBtn = document.getElementById('apply-crop-btn');
    const cancelCropBtn = document.getElementById('cancel-crop-btn');
    const cancelCropX = document.getElementById('cancel-crop-x');

    // Handle Image Selection and Open Crop Modal
    function openCropModalForFile(file, targetFrame) {
      if (!file || !file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        cropImageTarget.src = e.target.result;
        activeTargetFrame = targetFrame;
        cropModal.classList.remove('hidden');

        if (activeCropper) {
          activeCropper.destroy();
        }
        activeCropper = new Cropper(cropImageTarget, {
          aspectRatio: NaN, // Free crop aspect ratio
          viewMode: 1,
          autoCropArea: 0.9,
          background: false,
          responsive: true
        });
      };
      reader.readAsDataURL(file);
    }

    function closeCropModal() {
      cropModal.classList.add('hidden');
      if (activeCropper) {
        activeCropper.destroy();
        activeCropper = null;
      }
      activeTargetFrame = null;
    }

    cancelCropBtn.addEventListener('click', closeCropModal);
    cancelCropX.addEventListener('click', closeCropModal);

    applyCropBtn.addEventListener('click', () => {
      if (!activeCropper || !activeTargetFrame) return;
      const canvas = activeCropper.getCroppedCanvas();
      if (canvas) {
        const croppedDataUrl = canvas.toDataURL();
        let img = activeTargetFrame.querySelector('img');
        if (!img) {
          img = document.createElement('img');
          img.className = 'w-full h-full object-cover rounded-lg shadow-md';
          activeTargetFrame.appendChild(img);
        } else {
          img.src = croppedDataUrl;
        }
      }
      closeCropModal();
    });

    // Attach Drag & Drop + Click File Upload Listeners to Photo Frames
    function setupPhotoFrames() {
      const frames = document.querySelectorAll('.drop-zone, .payment-drop, .photo-frame');
      frames.forEach(frame => {
        // Drag events
        frame.addEventListener('dragover', (e) => {
          e.preventDefault();
          frame.classList.add('dragover');
        });
        frame.addEventListener('dragleave', () => {
          frame.classList.remove('dragover');
        });
        frame.addEventListener('drop', (e) => {
          e.preventDefault();
          frame.classList.remove('dragover');
          if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            openCropModalForFile(e.dataTransfer.files[0], frame);
          }
        });

        // Click to upload file directly
        const fileInput = frame.querySelector('.hidden-file-input');
        frame.addEventListener('click', (e) => {
          if (e.target.tagName !== 'INPUT' && fileInput) {
            fileInput.click();
          }
        });

        if (fileInput) {
          fileInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
              openCropModalForFile(e.target.files[0], frame);
            }
          });
        }
      });
    }

    // Student Data Repository
    let studentsData = [
      { id: '101', name: 'Alice Smith', avatar: '' },
      { id: '102', name: 'Charlie Brown', avatar: '' },
      { id: '103', name: 'Bob Jones', avatar: '' },
      { id: '104', name: 'Diana Prince', avatar: '' },
      { id: '105', name: 'Aaron Paul', avatar: '' }
    ];

    // Alphabetical Sorting Helper Function
    function getSortedStudents(list) {
      return list.slice().sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
    }

    // Render Student Lists (Filtered by Search Queries)
    function renderStudentList() {
      const teacherQuery = (document.getElementById('teacher-student-search')?.value || '').toLowerCase();
      const adminQuery = (document.getElementById('admin-student-search')?.value || '').toLowerCase();

      const sortedStudents = getSortedStudents(studentsData);

      // 1. Render Teacher Select Dropdowns
      const teacherFiltered = sortedStudents.filter(s => 
        s.name.toLowerCase().includes(teacherQuery) || s.id.toLowerCase().includes(teacherQuery)
      );

      const teacherSelectors = [
        document.getElementById('student-selector'),
        document.getElementById('student-selector-mobile')
      ];

      teacherSelectors.forEach(select => {
        if (!select) return;
        const currentVal = select.value;
        select.innerHTML = '';
        if (teacherFiltered.length === 0) {
          const opt = document.createElement('option');
          opt.textContent = 'No matching students';
          select.appendChild(opt);
        } else {
          teacherFiltered.forEach(student => {
            const option = document.createElement('option');
            option.value = student.id;
            option.textContent = `${student.name} (${student.id})`;
            select.appendChild(option);
          });
          if (currentVal && teacherFiltered.some(s => s.id === currentVal)) {
            select.value = currentVal;
          }
        }
      });

      // 2. Render Admin Portal Recruitment List
      const adminList = document.getElementById('admin-recruit-list');
      if (adminList) {
        const adminFiltered = sortedStudents.filter(s => 
          s.name.toLowerCase().includes(adminQuery) || s.id.toLowerCase().includes(adminQuery)
        );

        adminList.innerHTML = '';
        if (adminFiltered.length === 0) {
          adminList.innerHTML = `<div class="p-4 text-center text-indigo-300 text-xs">No students found matching "${adminQuery}"</div>`;
        } else {
          adminFiltered.forEach((student, index) => {
            const btn = document.createElement('button');
            btn.className = 'recruit-student cursor-pointer hover:border-amber-400 transition';
            btn.setAttribute('aria-pressed', index === 0 ? 'true' : 'false');
            btn.innerHTML = `
              <img src="${student.avatar || 'https://via.placeholder.com/44'}" alt="${student.name}" />
              <div>
                <strong>${student.name}</strong>
                <small>ID: ${student.id}</small>
              </div>
            `;
            adminList.appendChild(btn);
          });
        }
      }
    }

    // Attach Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      setupPhotoFrames();
      renderStudentList();

      // Search event listeners for real-time filtering
      const teacherSearchInput = document.getElementById('teacher-student-search');
      if (teacherSearchInput) {
        teacherSearchInput.addEventListener('input', renderStudentList);
      }

      const adminSearchInput = document.getElementById('admin-student-search');
      if (adminSearchInput) {
        adminSearchInput.addEventListener('input', renderStudentList);
      }
    });
  </script>
</body>
</html>
