    }

    #category-payment .pay-panel { background:rgba(49,46,129,.45); border:1px solid rgba(67,56,202,.6); border-radius:24px; padding:24px; box-shadow:0 10px 20px rgba(0,0,0,.12); }
    #category-payment .pay-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
    #category-payment label { display:block; font-size:12px; color:#c7d2fe; margin-bottom:7px; }
    #category-payment input, #category-payment select, #category-payment textarea, .pay-duration { background:#1e1b4b; border:1px solid #6366a0; border-radius:12px; padding:10px 12px; color:#fff; width:100%; font:inherit; font-size:14px; }
    #category-payment .pay-stat { background:#1e1b4b; border:1px solid #433884; border-radius:14px; padding:18px; }
    #category-payment .pay-stat strong { display:block; color:#fcd34d; font-size:27px; margin-top:5px; }
    .payment-drop { display:flex; align-items:center; justify-content:center; flex-direction:column; gap:12px; border:2px dashed #818cf8; background:#171637; border-radius:16px; min-height:240px; padding:20px; cursor:pointer; text-align:center; color:#c7d2fe; width:100%; }
    .payment-drop:focus-visible, .payment-drop.dragover { outline:3px solid #fcd34d; background:#312e81; }
    .payment-drop img { max-height:240px; max-width:100%; object-fit:contain; background:white; }
    #category-payment th, #category-payment td { padding:12px; text-align:left; border-bottom:1px solid #373064; }
    #category-payment th { color:#c7d2fe; font-size:12px; }
    #category-payment .pay-muted { color:#a5b4fc; font-size:12px; line-height:1.7; }
    #category-payment button { font-family:inherit; }
    #category-payment [hidden] { display:none !important; }
    #category-payment .pay-action { border-radius:12px; padding:10px 16px; font-size:12px; font-weight:700; background:linear-gradient(to right,#ec4899,#f43f5e); color:white; }
    #category-payment .pay-action:disabled { opacity:.45; cursor:not-allowed; }
    #category-payment .pay-secondary { background:#3730a3; }
    #category-payment input:focus, #category-payment select:focus { outline:2px solid #818cf8; outline-offset:2px; }
    @media(max-width:700px) { #category-payment .pay-grid { grid-template-columns:1fr; } #category-payment .pay-panel { padding:16px; } }

    /* Embedded company logo: no separate image file required. */
    .portal-brand-logo { display:block; object-fit:contain; flex-shrink:0; height:auto; }
    .portal-brand-login { width:132px; margin:0 auto 12px; }
    .portal-brand-nav { width:68px; }
    #login-gate-page { overflow-y:auto; }
    #login-gate-page > div { margin-top:auto; margin-bottom:auto; }
